# Copiá este archivo como .env en frontend/ y configurá una clave estable de al menos 32 caracteres.
# Ejemplo para generar FRONTEND_SECRET_KEY:
# python3 -c "import secrets; print(secrets.token_hex(32))"
FRONTEND_SECRET_KEY=
FRONTEND_PORT=5001
FRONTEND_COOKIE_SECURE=0
FRONTEND_SESSION_TTL=3600
API_URL=http://127.0.0.1:5000
BACKEND_API_URL=http://127.0.0.1:5000/api
