# Copiá este archivo como .env y completá los datos de tu MySQL local.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=centro_medico
DB_CONNECT_TIMEOUT=10

API_PORT=5000

# Autenticación JWT (generar clave fuerte de al menos 32 bytes, ej.: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
JWT_EXPIRATION_SECONDS=3600
