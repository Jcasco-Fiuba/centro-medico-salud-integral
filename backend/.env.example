# Copiá este archivo como .env y completá los datos de tu MySQL local.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=centro_medico
DB_CONNECT_TIMEOUT=10

API_PORT=5000

# Autenticación JWT (generar clave fuerte de al menos 32 bytes, ej.: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
JWT_EXPIRATION_SECONDS=3600

# --- Email (Flask-Mail / SMTP) ---
# Si MAIL_USERNAME/MAIL_PASSWORD están vacíos (o MAIL_SUPPRESS_SEND=true), NO se
# envía: se loguea el link/password (modo dev). Con Gmail, MAIL_PASSWORD es un
# "App Password" (no la clave de la cuenta).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente. Si se deja vacío, usa MAIL_USERNAME (Gmail exige que el from sea la
# cuenta autenticada).
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false