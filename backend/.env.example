# Copiá este archivo como .env y completá los datos de tu MySQL local.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=centro_medico
DB_CONNECT_TIMEOUT=10

API_PORT=5000

# Autenticación JWT (generar clave fuerte de al menos 32 bytes, ej.: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
JWT_EXPIRATION_SECONDS=3600

# Envío del QR de reserva por correo (Flask-Mail / SMTP).
# Completá MAIL_USERNAME y MAIL_PASSWORD en backend/.env.
# Para Gmail, MAIL_PASSWORD es la contraseña de aplicación de Google.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Si se deja vacío, se usa MAIL_USERNAME como remitente.
MAIL_DEFAULT_SENDER=

# Usá true para desactivar el envío durante las pruebas.
# Si faltan las credenciales o el envío está desactivado,
# el turno se reserva y el backend registra un aviso con su ID.
MAIL_SUPPRESS_SEND=false